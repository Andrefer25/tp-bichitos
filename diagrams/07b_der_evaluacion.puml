@startuml
title DER con tipos SQL der evaluacion
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Calibri
skinparam defaultFontSize 14
skinparam dpi 150
hide empty members
top to bottom direction
skinparam linetype ortho
entity "verificacion" as verificacion {
 * id : BIGINT <<PK>>
 * postulacion_id : BIGINT <<FK>>
   identidad_confirmada : BOOLEAN
   domicilio_confirmado : BOOLEAN
   consentimiento_confirmado : BOOLEAN
   observaciones : VARCHAR(500)
 * fecha : DATETIME
 * usuario_id : BIGINT <<FK>>
}
entity "evaluacion" as evaluacion {
 * id : BIGINT <<PK>>
 * postulacion_id : BIGINT <<FK>>
 * entrevista : ENUM E1
 * vivienda : ENUM E2
 * encuentro : ENUM E3
 * observaciones : TEXT
 * fecha : DATETIME
 * usuario_id : BIGINT <<FK>>
}
entity "evaluacion_actividad" as evaluacion_actividad {
 * evaluacion_id : BIGINT <<PK,FK>>
 * tipo : ENUM E4 <<PK>>
 * fecha : DATE
 * responsable_id : BIGINT <<FK>>
}
entity "postulacion\n(ver otra parte del DER)" as postulacion <<referencia>>
postulacion "1" -- "0..1" verificacion
entity "usuario\n(ver otra parte del DER)" as usuario <<referencia>>
usuario "1" -- "0..*" verificacion
postulacion "1" -- "0..1" evaluacion
usuario "1" -- "0..*" evaluacion
evaluacion "1" -- "0..*" evaluacion_actividad
usuario "1" -- "0..*" evaluacion_actividad
legend bottom
* Atributo obligatorio. PK y FK se identifican por separado.
E1 evaluacion.entrevista
  Valores: 'FAVORABLE', 'REVISAR', 'DESFAVORABLE'
E2 evaluacion.vivienda
  Valores: 'FAVORABLE', 'REVISAR', 'DESFAVORABLE'
E3 evaluacion.encuentro
  Valores: 'FAVORABLE', 'REVISAR', 'DESFAVORABLE'
E4 evaluacion_actividad.tipo
  Valores: 'ENTREVISTA', 'VIVIENDA', 'ENCUENTRO'
Las FK anulables permiten ausencia del padre; ver diccionario y DDL.
endlegend
@enduml
